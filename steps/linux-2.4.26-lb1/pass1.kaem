#!/bin/sh
# SPDX-FileCopyrightText: 2026 akunterkontrolle
# SPDX-License-Identifier: GPL-3.0-or-later
set -ex
checksum-transcriber sources
sha256sum -c sources.SHA256SUM
mkdir build
cd build
unbz2 --file ${DISTFILES}/linux-2.4.26.tar.bz2 --output linux-2.4.26.tar
tcc -D__SIZEOF_LONG_LONG__=8 -static -o ${BINDIR}/linux24-untar ../files/linux24-untar.c
linux24-untar --file linux-2.4.26.tar
rm linux-2.4.26.tar
mkdir tcc-kernel
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/arm-asm.c tcc-kernel/arm-asm.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/arm-gen.c tcc-kernel/arm-gen.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/arm-link.c tcc-kernel/arm-link.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/arm64-gen.c tcc-kernel/arm64-gen.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/arm64-link.c tcc-kernel/arm64-link.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/c67-gen.c tcc-kernel/c67-gen.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/c67-link.c tcc-kernel/c67-link.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/coff.h tcc-kernel/coff.h
