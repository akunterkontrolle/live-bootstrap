cp ../files/linux24-layout.h tcc-kernel/linux24-layout.h
simple-patch tcc-kernel/tccelf.c ../simple-patches/tcc-layout.before ../simple-patches/tcc-layout.after
simple-patch tcc-kernel/tccelf.c ../simple-patches/tcc-layout-call.before ../simple-patches/tcc-layout-call.after
cd tcc-kernel
tcc -D__SIZEOF_LONG_LONG__=8 -static -o ${BINDIR}/linux24-link -D TCC_TARGET_I386=1 -D CONFIG_TCCDIR=\"${LIBDIR}/tcc\" -D CONFIG_TCC_CRTPREFIX=\"${LIBDIR}\" -D CONFIG_TCC_ELFINTERP=\"/mes/loader\" -D CONFIG_TCC_LIBPATHS=\"${LIBDIR}:${LIBDIR}/tcc\" -D CONFIG_TCC_SYSINCLUDEPATHS=\"${PREFIX}/include/mes\" -D TCC_LIBGCC=\"${LIBDIR}/libc.a\" -D CONFIG_TCC_STATIC=1 -D CONFIG_USE_LIBGCC=1 -D TCC_VERSION=\"0.9.27-linux24-link\" -D ONE_SOURCE=1 tcc.c
cd ../linux-2.4.26
