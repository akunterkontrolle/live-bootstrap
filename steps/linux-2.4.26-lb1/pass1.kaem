cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/elf.h tcc-kernel/elf.h
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/i386-asm.c tcc-kernel/i386-asm.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/i386-asm.h tcc-kernel/i386-asm.h
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/i386-gen.c tcc-kernel/i386-gen.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/i386-link.c tcc-kernel/i386-link.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/i386-tok.h tcc-kernel/i386-tok.h
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/il-gen.c tcc-kernel/il-gen.c
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/il-opcodes.h tcc-kernel/il-opcodes.h
