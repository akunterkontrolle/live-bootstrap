cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/tcctok.h tcc-kernel/tcctok.h
cp ${SRCDIR}/tcc-0.9.27/build/tcc-0.9.27/tcctools.c tcc-kernel/tcctools.c
